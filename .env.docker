# Docker environment configuration
ENVIRONMENT=development

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
API_PREFIX=/api/v1

# Database (uses docker service name)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth
DB_SSL_MODE=disable

# Redis (uses docker service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (dev secrets - do not use in production)
JWT_ACCESS_SECRET=dev-access-secret-key-change-in-production-minimum-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-key-change-in-production-minimum-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
JWT_REMEMBER_ME_EXPIRY=720h
JWT_ISSUER=ven-auth

# Auth
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_MAX_LOGIN_ATTEMPTS=7
AUTH_LOCKOUT_DURATION=5m

# SSO (disabled for local dev)
SSO_GOOGLE_ENABLED=false
SSO_APPLE_ENABLED=false
SSO_MICROSOFT_ENABLED=false
SSO_GITHUB_ENABLED=false

# Email (no-op for local dev)
EMAIL_PROVIDER=
SMTP_HOST=

# Security
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
CORS_ORIGINS=*

# Migrations
RUN_MIGRATIONS=true
