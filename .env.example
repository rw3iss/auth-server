# rw3iss Authentication Server Configuration
# Copy this file to .env and update the values

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Route prefix all API routes are served under (matches the documented
# /api/v1/... contract + every client default, e.g. @rw3iss/auth-client).
API_PREFIX=/api/v1
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s
ENVIRONMENT=development

# CORS - comma-separated list of allowed origins (* for all)
CORS_ORIGINS=*

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=auth
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# =============================================================================
# JWT Configuration
# =============================================================================
# IMPORTANT: Generate secure random strings for production!
# Use: openssl rand -hex 32
JWT_ACCESS_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
JWT_REMEMBER_ME_EXPIRY=720h
JWT_ISSUER=ven-auth
JWT_AUDIENCE=ven-platform
JWT_SIGNING_METHOD=HS256

# =============================================================================
# Authentication Configuration
# =============================================================================
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_SPECIAL=false
AUTH_MAX_LOGIN_ATTEMPTS=7
AUTH_LOCKOUT_DURATION=5m
AUTH_PASSWORD_RESET_EXPIRY=1h
AUTH_EMAIL_VERIFICATION_EXPIRY=24h
AUTH_INVITATION_EXPIRY=168h
AUTH_SESSION_TIMEOUT=24h

# =============================================================================
# SSO Configuration - Google
# =============================================================================
SSO_GOOGLE_ENABLED=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/sso/callback
SSO_GOOGLE_SCOPES=openid,email,profile

# =============================================================================
# SSO Configuration - Apple
# =============================================================================
SSO_APPLE_ENABLED=false
SSO_APPLE_CLIENT_ID=
SSO_APPLE_CLIENT_SECRET=
SSO_APPLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/sso/callback
SSO_APPLE_SCOPES=name,email
# Apple-specific. SSO_APPLE_CLIENT_ID is the Service ID. The client secret is
# an ES256 JWT signed from the .p8 key (not a static SSO_APPLE_CLIENT_SECRET):
SSO_APPLE_TEAM_ID=          # Apple Developer Team ID (JWT iss)
SSO_APPLE_KEY_ID=           # .p8 Key ID (JWT header kid)
SSO_APPLE_PRIVATE_KEY=      # PKCS#8 .p8 contents — raw PEM or base64-encoded PEM

# =============================================================================
# SSO Configuration - Microsoft
# =============================================================================
SSO_MICROSOFT_ENABLED=false
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_REDIRECT_URL=http://localhost:8080/api/v1/auth/sso/callback
SSO_MICROSOFT_SCOPES=openid,email,profile

# =============================================================================
# SSO Configuration - GitHub
# =============================================================================
SSO_GITHUB_ENABLED=false
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=
SSO_GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/sso/callback
SSO_GITHUB_SCOPES=user:email

# =============================================================================
# SSO Configuration - Facebook (OAuth2 / Graph API)
# =============================================================================
SSO_FACEBOOK_ENABLED=false
SSO_FACEBOOK_CLIENT_ID=
SSO_FACEBOOK_CLIENT_SECRET=
SSO_FACEBOOK_REDIRECT_URL=http://localhost:8080/api/v1/auth/sso/callback
SSO_FACEBOOK_SCOPES=email,public_profile

# =============================================================================
# SSO Configuration - LinkedIn (Sign In with LinkedIn using OpenID Connect)
# =============================================================================
SSO_LINKEDIN_ENABLED=false
SSO_LINKEDIN_CLIENT_ID=
SSO_LINKEDIN_CLIENT_SECRET=
SSO_LINKEDIN_REDIRECT_URL=http://localhost:8080/api/v1/auth/sso/callback
SSO_LINKEDIN_SCOPES=openid,profile,email

# =============================================================================
# GlobalSKU JIT legacy migration (§5.1). Verifies a live password attempt
# against GlobalSKU's signed /api/internal/verify-legacy-password endpoint.
# GLOBALSKU_LEGACY_VERIFY_SECRET is the shared HMAC secret (identical on both
# sides) — NOT a password-hashing key. Registered under app_code "globalsku".
# =============================================================================
GLOBALSKU_LEGACY_MIGRATION_ENABLED=false
GLOBALSKU_BASE_URL=
GLOBALSKU_LEGACY_VERIFY_SECRET=

# =============================================================================
# Client URL (used in email links for password reset, etc.)
# =============================================================================
CLIENT_URL=http://localhost:3000

# =============================================================================
# Email Configuration
# =============================================================================
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=rw3iss Auth
EMAIL_TEMPLATES_PATH=./templates/email

# SMTP Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true

# For SendGrid/Mailgun (alternative)
EMAIL_API_KEY=

# =============================================================================
# Redis Configuration (optional - for distributed rate limiting)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2

# =============================================================================
# Security Configuration
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
BCRYPT_COST=12
CSRF_ENABLED=true
CSRF_SECRET=change-this-to-a-secure-random-string

# =============================================================================
# Identity Provider — OIDC + FedCM  (docs/FEDCM.md)
# =============================================================================
# The issuer MUST equal the base URL relying parties use, character for
# character: every OIDC client compares the `iss` claim against the URL it
# discovered from, and a mismatch is a hard failure.
OIDC_ISSUER=https://auth.civicgate.org
# Where /oauth/authorize and /fedcm/login send an unauthenticated visitor.
OIDC_LOGIN_URL=https://www.civicgate.org/login
# Signing key resolution: OIDC_PRIVATE_KEY_PEM > OIDC_PRIVATE_KEY_FILE >
# OIDC_KEY_DIR/oidc-signing-key.pem (generated + persisted on first boot).
# A key that regenerates on restart would invalidate every outstanding ID
# token and every cached JWKS, silently, on every deploy.
OIDC_KEY_DIR=

# Write the session cookie SameSite=None; Secure on `cookie_mode: true` logins.
# REQUIRED for FedCM: the browser calls /fedcm/accounts from a page on the
# relying party's origin, and a Lax cookie is simply not attached there — the
# endpoint then honestly answers "no accounts" with a valid session in place and
# nothing in any log to explain it. Defaults ON when the provider is enabled.
# CORS_ORIGINS must also list the login UI's origin EXACTLY (a wildcard cannot
# carry credentials).
AUTH_COOKIE_CROSS_SITE=
# Widen the cookie to a parent domain (e.g. .civicgate.org). Leave unset for
# FedCM — host-only is correct, and safer.
AUTH_COOKIE_DOMAIN=

# Branding for the account chooser the BROWSER draws. It is the only visual
# control an IdP has in a FedCM flow; a chooser that does not look like the
# product reads as a phishing dialog. Icon must be >= 25px (passive mode) or
# >= 40px (button mode).
FEDCM_BRAND_NAME=
FEDCM_BRAND_ICON_URL=
FEDCM_BRAND_BACKGROUND=
FEDCM_BRAND_COLOR=
