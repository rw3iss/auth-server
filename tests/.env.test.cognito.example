# Copy to tests/.env.test.cognito and fill in real values.
# tests/.env.test.cognito is gitignored — NEVER commit real credentials.
#
# These env vars are picked up by the Cognito migration integration tests
# (build tag: integration_cognito). Tests skip silently when these are
# absent so the regular `go test` and integration runs continue to work.
#
# AWS credentials default to whatever the standard AWS credential chain
# resolves (~/.aws/credentials, instance profile, etc.). The two env vars
# here only need to be set if you can't use that default chain — e.g.
# running tests against a different account than your default profile.

# Default AWS credentials (optional — falls back to default chain).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Cognito pool to authenticate against during the tests.
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only set if the app client has a client secret configured.
# COGNITO_CLIENT_SECRET=

# Demo users that should already exist in the pool. Tests authenticate
# against them and verify the migration mirrors their attributes + groups
# into the internal store. Passwords here are the ACTUAL passwords for
# those Cognito accounts — handle accordingly. Defaults work against the
# Vendidit dev pool; override locally if testing elsewhere.
COGNITO_TEST_PASSWORD=
COGNITO_TEST_SELLER_EMAIL=ryan+seller@vendidit.com
COGNITO_TEST_SELLER2_EMAIL=ryan+seller2@vendidit.com
COGNITO_TEST_BUYER_EMAIL=ryan+buyer@vendidit.com
